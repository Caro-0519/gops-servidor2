# Copia este archivo con el nombre .env y completa los valores:  cp .env.example .env
# El archivo .env NO se sube a GitHub (está en .gitignore). Aquí no hay credenciales reales.

# --- IA (opcional: sin esto la app funciona igual y el auditor usa solo sus reglas) ---
# Proveedor: gemini | anthropic | openai | none
IA_PROVIDER=gemini
# Llave del proveedor (Google AI Studio para Gemini). Pégala solo en tu .env, nunca en el código.
IA_API_KEY=PEGA_AQUI_TU_LLAVE
# Modelo principal (vacío = el de por defecto del proveedor)
IA_MODEL=gemini-3.7-flash
# Modelo de respaldo si el principal está saturado (opcional)
IA_MODEL_ALT=gemini-3.5-flash-lite
# Solo para modelos propios o compatibles con OpenAI (por ejemplo Ollama)
IA_BASE_URL=

# --- Servidor (opcionales; ya tienen valor por defecto) ---
# Duración de la sesión en horas
TOKEN_HORAS=12
# Secreto para firmar los tokens (vacío = se genera uno aleatorio y se guarda en la base)
JWT_SECRET=
# Esperas entre reintentos cuando la IA está saturada, en milisegundos
IA_ESPERAS_MS=2000,5000,10000
